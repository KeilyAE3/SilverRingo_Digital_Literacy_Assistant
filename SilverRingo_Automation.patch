+name: Team Sync
+
+on:
+  push:
+    branches: ['**']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: team-sync-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  check:
+    name: Collaboration and configured application checks
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Test automation logic
+        run: python -m unittest discover -s automation/tests -v
+      - name: Validate, run configured checks, and summarize
+        env:
+          SYNC_BASE: ${{ github.event.before }}
+        run: python automation/check.py
+      - name: Keep synchronization summary
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: team-sync-${{ github.run_id }}-${{ github.run_attempt }}
+          path: .team-sync-summary.md
+          if-no-files-found: warn
+          retention-days: 14
